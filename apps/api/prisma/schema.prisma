generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["ai_engine", "analytics", "audit", "common", "construction", "financial", "identity", "inspection", "logistics", "marketplace", "property", "sales"]
}

model Country {
  code         String    @id @db.VarChar(2)
  name         String    @db.VarChar(100)
  currencyCode String?   @map("currency_code") @db.VarChar(3)
  phoneCode    String    @map("phone_code") @db.VarChar(5)
  isActive     Boolean   @default(true) @map("is_active")
  currencies   Currency? @relation(fields: [currencyCode], references: [code], onDelete: NoAction, onUpdate: NoAction)

  @@map("countries")
  @@schema("common")
}

model Currency {
  code          String    @id @db.VarChar(3)
  name          String    @db.VarChar(50)
  symbol        String    @db.VarChar(5)
  decimalPlaces Int       @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean   @default(true) @map("is_active")
  countries     Country[]

  @@map("currencies")
  @@schema("common")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaName String   @map("schema_name") @db.VarChar(50)
  tableName  String   @map("table_name") @db.VarChar(100)
  recordId   String   @map("record_id") @db.Uuid
  action     String   @db.VarChar(20)
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  userId     String?  @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schemaName, tableName, recordId], map: "idx_audit_logs_record")
  @@index([userId], map: "idx_audit_logs_user")
  @@index([createdAt], map: "idx_audit_logs_created")
  @@map("logs")
  @@schema("audit")
}

model IdentityUser {
  id                                                                    String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                                 String                          @unique @db.VarChar(255)
  phone                                                                 String?                         @db.VarChar(20)
  passwordHash                                                          String?                         @map("password_hash") @db.VarChar(255)
  firstName                                                             String                          @map("first_name") @db.VarChar(100)
  lastName                                                              String                          @map("last_name") @db.VarChar(100)
  avatarUrl                                                             String?                         @map("avatar_url")
  status                                                                String                          @default("active") @db.VarChar(20)
  emailVerifiedAt                                                       DateTime?                       @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt                                                       DateTime?                       @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt                                                           DateTime?                       @map("last_login_at") @db.Timestamptz(6)
  createdAt                                                             DateTime?                       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                             DateTime?                       @default(now()) @map("updated_at") @db.Timestamptz(6)
  companies_companies_created_byTousers                                 Company[]                       @relation("companies_created_byTousers")
  companies_companies_verified_byTousers                                Company[]                       @relation("companies_verified_byTousers")
  company_documents_company_documents_reviewed_byTousers                CompanyDocument[]               @relation("company_documents_reviewed_byTousers")
  company_documents_company_documents_uploaded_byTousers                CompanyDocument[]               @relation("company_documents_uploaded_byTousers")
  company_invitations_company_invitations_accepted_byTousers            CompanyInvitation[]             @relation("company_invitations_accepted_byTousers")
  company_invitations_company_invitations_invited_byTousers             CompanyInvitation[]             @relation("company_invitations_invited_byTousers")
  company_members_company_members_invited_byTousers                     CompanyMember[]                 @relation("company_members_invited_byTousers")
  company_members_company_members_revoked_byTousers                     CompanyMember[]                 @relation("company_members_revoked_byTousers")
  company_members_company_members_user_idTousers                        CompanyMember[]                 @relation("company_members_user_idTousers")
  company_orphaned_tasks_company_orphaned_tasks_assignee_idTousers      CompanyOrphanedTask[]           @relation("company_orphaned_tasks_assignee_idTousers")
  company_orphaned_tasks_company_orphaned_tasks_closed_byTousers        CompanyOrphanedTask[]           @relation("company_orphaned_tasks_closed_byTousers")
  company_orphaned_tasks_company_orphaned_tasks_original_user_idTousers CompanyOrphanedTask[]           @relation("company_orphaned_tasks_original_user_idTousers")
  kyc_verifications_kyc_verifications_reviewer_idTousers                IdentityKycVerification[]       @relation("kyc_verifications_reviewer_idTousers")
  kyc_verifications_kyc_verifications_user_idTousers                    IdentityKycVerification[]       @relation("kyc_verifications_user_idTousers")
  lead_activities                                                       IdentityLeadActivity[]
  leads                                                                 IdentityLead[]
  mfa_configs                                                           IdentityMfaConfig?
  notification_preferences                                              IdentityNotificationPreference?
  professional_licences_professional_licences_user_idTousers            IdentityProfessionalLicence[]   @relation("professional_licences_user_idTousers")
  professional_licences_professional_licences_verified_byTousers        IdentityProfessionalLicence[]   @relation("professional_licences_verified_byTousers")
  refresh_tokens                                                        IdentityRefreshToken[]
  user_business_profiles                                                user_business_profiles?
  user_roles_user_roles_assigned_byTousers                              IdentityUserRole[]              @relation("user_roles_assigned_byTousers")
  user_roles_user_roles_user_idTousers                                  IdentityUserRole[]              @relation("user_roles_user_idTousers")
  user_sessions                                                         IdentityUserSession[]

  @@map("users")
  @@schema("identity")
}

model IdentityRole {
  id                                               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                             String                   @unique @db.VarChar(50)
  displayName                                      String                   @map("display_name") @db.VarChar(100)
  description                                      String?
  createdAt                                        DateTime?                @default(now()) @map("created_at") @db.Timestamptz(6)
  role_exclusions_role_exclusions_role_a_idToroles IdentityRoleExclusion[]  @relation("role_exclusions_role_a_idToroles")
  role_exclusions_role_exclusions_role_b_idToroles IdentityRoleExclusion[]  @relation("role_exclusions_role_b_idToroles")
  role_permissions                                 IdentityRolePermission[]
  user_roles                                       IdentityUserRole[]

  @@map("roles")
  @@schema("identity")
}

model IdentityUserRole {
  userId                              String        @map("user_id") @db.Uuid
  roleId                              String        @map("role_id") @db.Uuid
  assignedBy                          String?       @map("assigned_by") @db.Uuid
  assignedAt                          DateTime?     @default(now()) @map("assigned_at") @db.Timestamptz(6)
  users_user_roles_assigned_byTousers IdentityUser? @relation("user_roles_assigned_byTousers", fields: [assignedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles                               IdentityRole  @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_user_roles_user_idTousers     IdentityUser  @relation("user_roles_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([userId, roleId])
  @@map("user_roles")
  @@schema("identity")
}

model IdentityPermission {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource         String                   @db.VarChar(100)
  action           String                   @db.VarChar(50)
  role_permissions IdentityRolePermission[]

  @@unique([resource, action])
  @@map("permissions")
  @@schema("identity")
}

model IdentityRolePermission {
  roleId       String             @map("role_id") @db.Uuid
  permissionId String             @map("permission_id") @db.Uuid
  permissions  IdentityPermission @relation(fields: [permissionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  roles        IdentityRole       @relation(fields: [roleId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@map("role_permissions")
  @@schema("identity")
}

model IdentityKycVerification {
  id                                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                     String?       @map("user_id") @db.Uuid
  status                                     String        @default("pending") @db.VarChar(20)
  idDocumentUrl                              String?       @map("id_document_url")
  idDocumentType                             String?       @map("id_document_type") @db.VarChar(50)
  addressProofUrl                            String?       @map("address_proof_url")
  businessRegistrationUrl                    String?       @map("business_registration_url")
  selfieUrl                                  String?       @map("selfie_url")
  reviewerId                                 String?       @map("reviewer_id") @db.Uuid
  reviewerNotes                              String?       @map("reviewer_notes")
  reviewedAt                                 DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  submittedAt                                DateTime?     @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt                                  DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  livenessCheckPassed                        Boolean?      @map("liveness_check_passed")
  livenessScore                              Decimal?      @map("liveness_score") @db.Decimal(5, 4)
  faceMatchScore                             Decimal?      @map("face_match_score") @db.Decimal(5, 4)
  biometricProvider                          String?       @map("biometric_provider") @db.VarChar(50)
  biometricReference                         String?       @map("biometric_reference") @db.VarChar(255)
  riskLevel                                  String?       @map("risk_level") @db.VarChar(20)
  pepCheckPassed                             Boolean?      @map("pep_check_passed")
  sanctionsCheckPassed                       Boolean?      @map("sanctions_check_passed")
  amlCheckPassed                             Boolean?      @map("aml_check_passed")
  users_kyc_verifications_reviewer_idTousers IdentityUser? @relation("kyc_verifications_reviewer_idTousers", fields: [reviewerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_kyc_verifications_user_idTousers     IdentityUser? @relation("kyc_verifications_user_idTousers", fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([status, submittedAt], map: "idx_identity_kyc_status_submitted")
  @@map("kyc_verifications")
  @@schema("identity")
}

model IdentityAuditLog {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String    @map("event_id") @db.VarChar(100)
  actorId        String?   @map("actor_id") @db.Uuid
  actorRole      String?   @map("actor_role") @db.VarChar(50)
  action         String    @db.VarChar(100)
  resourceType   String?   @map("resource_type") @db.VarChar(100)
  resourceId     String?   @map("resource_id") @db.Uuid
  payload        Json?
  ipAddress      String?   @map("ip_address") @db.Inet
  userAgent      String?   @map("user_agent")
  deviceMetadata Json?     @map("device_metadata")
  createdAt      DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  companyId      String?   @map("company_id") @db.Uuid

  @@index([actorId, createdAt], map: "idx_identity_audit_actor_created")
  @@index([resourceType, resourceId], map: "idx_identity_audit_resource")
  @@index([companyId], map: "idx_identity_audit_company")
  @@map("audit_logs")
  @@schema("identity")
}

model IdentityRefreshToken {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  tokenHash       String        @map("token_hash") @db.VarChar(255)
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  activeCompanyId String?       @map("active_company_id") @db.Uuid
  companies       Company?      @relation(fields: [activeCompanyId], references: [id], onUpdate: NoAction)
  users           IdentityUser? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId], map: "idx_identity_refresh_user")
  @@map("refresh_tokens")
  @@schema("identity")
}

model Company {
  id                                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                               String                 @db.VarChar(255)
  slug                               String                 @unique @db.VarChar(100)
  category                           String                 @db.VarChar(50)
  registrationNumber                 String?                @map("registration_number") @db.VarChar(100)
  taxNumber                          String?                @map("tax_number") @db.VarChar(100)
  website                            String?                @db.VarChar(255)
  phone                              String?                @db.VarChar(20)
  email                              String                 @db.VarChar(255)
  address                            Json?                  @default("{}")
  logoUrl                            String?                @map("logo_url")
  description                        String?
  status                             String                 @default("pending_verification") @db.VarChar(30)
  verificationStatus                 String?                @default("unverified") @map("verification_status") @db.VarChar(30)
  verifiedBy                         String?                @map("verified_by") @db.Uuid
  verifiedAt                         DateTime?              @map("verified_at") @db.Timestamptz(6)
  rejectionReason                    String?                @map("rejection_reason")
  createdBy                          String?                @map("created_by") @db.Uuid
  createdAt                          DateTime?              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                          DateTime?              @default(now()) @map("updated_at") @db.Timestamptz(6)
  isSystem                           Boolean                @default(false) @map("is_system")
  users_companies_created_byTousers  IdentityUser?          @relation("companies_created_byTousers", fields: [createdBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_companies_verified_byTousers IdentityUser?          @relation("companies_verified_byTousers", fields: [verifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  documents                          CompanyDocument[]
  invitations                        CompanyInvitation[]
  members                            CompanyMember[]
  orphanedTasks                      CompanyOrphanedTask[]
  refresh_tokens                     IdentityRefreshToken[]
  user_notifications                 user_notifications[]

  @@index([category], map: "idx_companies_category")
  @@index([status], map: "idx_companies_status")
  @@index([verificationStatus], map: "idx_companies_verification_status")
  @@map("companies")
  @@schema("identity")
}

model CompanyDocument {
  id                                         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                  String        @map("company_id") @db.Uuid
  uploadedBy                                 String        @map("uploaded_by") @db.Uuid
  documentType                               String        @default("other") @map("document_type") @db.VarChar(100)
  documentName                               String        @map("document_name") @db.VarChar(255)
  fileName                                   String        @map("file_name") @db.VarChar(255)
  storagePath                                String        @map("storage_path")
  publicUrl                                  String        @map("public_url")
  mimeType                                   String?       @map("mime_type") @db.VarChar(100)
  fileSizeBytes                              Int?          @map("file_size_bytes")
  status                                     String        @default("pending") @db.VarChar(30)
  reviewNotes                                String?       @map("review_notes")
  reviewedBy                                 String?       @map("reviewed_by") @db.Uuid
  reviewedAt                                 DateTime?     @map("reviewed_at") @db.Timestamptz(6)
  createdAt                                  DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                  DateTime?     @default(now()) @map("updated_at") @db.Timestamptz(6)
  company                                    Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_company_documents_reviewed_byTousers IdentityUser? @relation("company_documents_reviewed_byTousers", fields: [reviewedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_company_documents_uploaded_byTousers IdentityUser  @relation("company_documents_uploaded_byTousers", fields: [uploadedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId], map: "idx_company_documents_company")
  @@index([companyId, status], map: "idx_company_documents_status")
  @@map("company_documents")
  @@schema("identity")
}

model CompanyMember {
  id                                      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                               String        @map("company_id") @db.Uuid
  userId                                  String        @map("user_id") @db.Uuid
  role                                    String        @db.VarChar(50)
  isAdmin                                 Boolean       @default(false) @map("is_admin")
  status                                  String        @default("active") @db.VarChar(30)
  permissions                             Json?         @default("[]")
  invitedBy                               String?       @map("invited_by") @db.Uuid
  joinedAt                                DateTime?     @default(now()) @map("joined_at") @db.Timestamptz(6)
  revokedAt                               DateTime?     @map("revoked_at") @db.Timestamptz(6)
  revokedBy                               String?       @map("revoked_by") @db.Uuid
  createdAt                               DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                               DateTime?     @default(now()) @map("updated_at") @db.Timestamptz(6)
  commissionSplitPct                      Decimal?      @map("commission_split_pct") @db.Decimal(5, 2)
  company                                 Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_company_members_invited_byTousers IdentityUser? @relation("company_members_invited_byTousers", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_company_members_revoked_byTousers IdentityUser? @relation("company_members_revoked_byTousers", fields: [revokedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_company_members_user_idTousers    IdentityUser  @relation("company_members_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([companyId, userId])
  @@index([companyId], map: "idx_company_members_company")
  @@index([userId], map: "idx_company_members_user")
  @@index([status], map: "idx_company_members_status")
  @@map("company_members")
  @@schema("identity")
}

model CompanyInvitation {
  id                                           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                    String        @map("company_id") @db.Uuid
  invitedEmail                                 String        @map("invited_email") @db.VarChar(255)
  role                                         String        @db.VarChar(50)
  isAdmin                                      Boolean       @default(false) @map("is_admin")
  permissions                                  Json?         @default("[]")
  tokenHash                                    String        @unique(map: "idx_company_invitations_token_hash") @map("token_hash") @db.VarChar(64)
  status                                       String        @default("pending") @db.VarChar(30)
  invitedBy                                    String?       @map("invited_by") @db.Uuid
  acceptedBy                                   String?       @map("accepted_by") @db.Uuid
  expiresAt                                    DateTime      @map("expires_at") @db.Timestamptz(6)
  acceptedAt                                   DateTime?     @map("accepted_at") @db.Timestamptz(6)
  revokedAt                                    DateTime?     @map("revoked_at") @db.Timestamptz(6)
  createdAt                                    DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  users_company_invitations_accepted_byTousers IdentityUser? @relation("company_invitations_accepted_byTousers", fields: [acceptedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company                                      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_company_invitations_invited_byTousers  IdentityUser? @relation("company_invitations_invited_byTousers", fields: [invitedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status], map: "idx_company_invitations_company")
  @@map("company_invitations")
  @@schema("identity")
}

model CompanyOrphanedTask {
  id                                                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId                                            String        @map("company_id") @db.Uuid
  originalUserId                                       String        @map("original_user_id") @db.Uuid
  assigneeId                                           String?       @map("assignee_id") @db.Uuid
  resourceType                                         String        @map("resource_type") @db.VarChar(100)
  resourceId                                           String?       @map("resource_id") @db.Uuid
  description                                          String?
  requiresNotification                                 Boolean       @default(false) @map("requires_notification")
  notificationNotes                                    String?       @map("notification_notes")
  status                                               String        @default("unassigned") @db.VarChar(30)
  assignedAt                                           DateTime?     @map("assigned_at") @db.Timestamptz(6)
  closedAt                                             DateTime?     @map("closed_at") @db.Timestamptz(6)
  closedBy                                             String?       @map("closed_by") @db.Uuid
  createdAt                                            DateTime?     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                            DateTime?     @default(now()) @map("updated_at") @db.Timestamptz(6)
  users_company_orphaned_tasks_assignee_idTousers      IdentityUser? @relation("company_orphaned_tasks_assignee_idTousers", fields: [assigneeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users_company_orphaned_tasks_closed_byTousers        IdentityUser? @relation("company_orphaned_tasks_closed_byTousers", fields: [closedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)
  company                                              Company       @relation(fields: [companyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_company_orphaned_tasks_original_user_idTousers IdentityUser  @relation("company_orphaned_tasks_original_user_idTousers", fields: [originalUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([companyId, status], map: "idx_company_orphaned_tasks_company")
  @@index([originalUserId], map: "idx_company_orphaned_tasks_user")
  @@map("company_orphaned_tasks")
  @@schema("identity")
}

model IdentityRoleExclusion {
  roleAId                                String       @map("role_a_id") @db.Uuid
  roleBId                                String       @map("role_b_id") @db.Uuid
  reason                                 String?
  roles_role_exclusions_role_a_idToroles IdentityRole @relation("role_exclusions_role_a_idToroles", fields: [roleAId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  roles_role_exclusions_role_b_idToroles IdentityRole @relation("role_exclusions_role_b_idToroles", fields: [roleBId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleAId, roleBId])
  @@map("role_exclusions")
  @@schema("identity")
}

model IdentityProfessionalLicence {
  id                                             String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                                         String        @map("user_id") @db.Uuid
  licenceType                                    String        @map("licence_type") @db.VarChar(50)
  licenceNumber                                  String        @map("licence_number") @db.VarChar(100)
  issuingBody                                    String        @map("issuing_body") @db.VarChar(255)
  issueDate                                      DateTime?     @map("issue_date") @db.Date
  expiryDate                                     DateTime?     @map("expiry_date") @db.Date
  licenceDocumentUrl                             String?       @map("licence_document_url")
  status                                         String        @default("unverified") @db.VarChar(20)
  verifiedBy                                     String?       @map("verified_by") @db.Uuid
  verifiedAt                                     DateTime?     @map("verified_at") @db.Timestamptz(6)
  autoCheckUrl                                   String?       @map("auto_check_url")
  autoCheckedAt                                  DateTime?     @map("auto_checked_at") @db.Timestamptz(6)
  createdAt                                      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                      DateTime      @default(now()) @map("updated_at") @db.Timestamptz(6)
  users_professional_licences_user_idTousers     IdentityUser  @relation("professional_licences_user_idTousers", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_professional_licences_verified_byTousers IdentityUser? @relation("professional_licences_verified_byTousers", fields: [verifiedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId, licenceType], map: "idx_professional_licences_user")
  @@index([status], map: "idx_professional_licences_status")
  @@map("professional_licences")
  @@schema("identity")
}

model IdentityUserSession {
