// PRIBEC Database Schema
// PostgreSQL configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "property", "sales", "financial", "construction", "marketplace", "logistics", "inspection", "analytics", "ai_engine", "audit", "common"]
}

// ============================================
// COMMON SCHEMA - Shared Lookup Tables
// ============================================

model Country {
  code         String  @id @db.VarChar(2)
  name         String  @db.VarChar(100)
  currencyCode String? @map("currency_code") @db.VarChar(3)
  phoneCode    String  @map("phone_code") @db.VarChar(5)
  isActive     Boolean @default(true) @map("is_active")

  @@schema("common")
  @@map("countries")
}

model Currency {
  code          String  @id @db.VarChar(3)
  name          String  @db.VarChar(50)
  symbol        String  @db.VarChar(5)
  decimalPlaces Int     @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean @default(true) @map("is_active")

  @@schema("common")
  @@map("currencies")
}

// ============================================
// AUDIT SCHEMA - Cross-cutting Audit Logs
// ============================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaName String   @map("schema_name") @db.VarChar(50)
  tableName  String   @map("table_name") @db.VarChar(100)
  recordId   String   @map("record_id") @db.Uuid
  action     String   @db.VarChar(20) // INSERT, UPDATE, DELETE
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  userId     String?  @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schemaName, tableName, recordId], name: "idx_audit_logs_record")
  @@index([userId], name: "idx_audit_logs_user")
  @@index([createdAt], name: "idx_audit_logs_created")
  @@schema("audit")
  @@map("logs")
}

// ============================================
// IDENTITY SCHEMA - Users, Roles, KYC
// ============================================

model IdentityUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  avatarUrl       String?   @map("avatar_url") @db.Text
  status          String    @default("active") @db.VarChar(20)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("users")
}

model IdentityRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("roles")
}

model IdentityUserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([userId, roleId])
  @@schema("identity")
  @@map("user_roles")
}

model IdentityPermission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource String @db.VarChar(100)
  action   String @db.VarChar(50)

  @@unique([resource, action])
  @@schema("identity")
  @@map("permissions")
}

model IdentityRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  @@id([roleId, permissionId])
  @@schema("identity")
  @@map("role_permissions")
}

model IdentityKycVerification {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  status                  String    @default("pending") @db.VarChar(20)
  idDocumentUrl           String?   @map("id_document_url") @db.Text
  idDocumentType          String?   @map("id_document_type") @db.VarChar(50)
  addressProofUrl         String?   @map("address_proof_url") @db.Text
  businessRegistrationUrl String?   @map("business_registration_url") @db.Text
  selfieUrl               String?   @map("selfie_url") @db.Text
  reviewerId              String?   @map("reviewer_id") @db.Uuid
  reviewerNotes           String?   @map("reviewer_notes") @db.Text
  reviewedAt              DateTime? @map("reviewed_at") @db.Timestamptz(6)
  submittedAt             DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  // Sprint 02 Enhanced — biometric & AML fields
  livenessCheckPassed     Boolean?  @map("liveness_check_passed")
  livenessScore           Decimal?  @map("liveness_score") @db.Decimal(5, 4)
  faceMatchScore          Decimal?  @map("face_match_score") @db.Decimal(5, 4)
  biometricProvider       String?   @map("biometric_provider") @db.VarChar(50)
  biometricReference      String?   @map("biometric_reference") @db.VarChar(255)
  riskLevel               String?   @map("risk_level") @db.VarChar(20)
  pepCheckPassed          Boolean?  @map("pep_check_passed")
  sanctionsCheckPassed    Boolean?  @map("sanctions_check_passed")
  amlCheckPassed          Boolean?  @map("aml_check_passed")

  @@index([userId], name: "idx_kyc_user")
  @@index([status, submittedAt], name: "idx_kyc_status_submitted")
  @@schema("identity")
  @@map("kyc_verifications")
}

model IdentityAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.VarChar(100)
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String?  @map("actor_role") @db.VarChar(50)
  companyId      String?  @map("company_id") @db.Uuid
  action         String   @db.VarChar(100)
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  payload        Json?    @db.JsonB
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  deviceMetadata Json?    @map("device_metadata") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt], name: "idx_identity_audit_actor_created")
  @@index([resourceType, resourceId], name: "idx_identity_audit_resource")
  @@schema("identity")
  @@map("audit_logs")
}

model IdentityRefreshToken {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  tokenHash       String    @map("token_hash") @db.VarChar(255)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  activeCompanyId String?   @map("active_company_id") @db.Uuid

  @@index([userId], name: "idx_refresh_tokens_user")
  @@schema("identity")
  @@map("refresh_tokens")
}

// ============================================
// IDENTITY SCHEMA - Companies (Sprint 01-b)
// ============================================

model Company {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(255)
  slug               String    @unique @db.VarChar(100)
  category           String    @db.VarChar(50)
  registrationNumber String?   @map("registration_number") @db.VarChar(100)
  taxNumber          String?   @map("tax_number") @db.VarChar(100)
  website            String?   @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  email              String    @db.VarChar(255)
  address            Json      @default("{}") @db.JsonB
  logoUrl            String?   @map("logo_url") @db.Text
  description        String?   @db.Text
  status             String    @default("pending_verification") @db.VarChar(30)
  verificationStatus String    @default("unverified") @map("verification_status") @db.VarChar(30)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  rejectionReason    String?   @map("rejection_reason") @db.Text
  isSystem           Boolean   @default(false) @map("is_system")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  members     CompanyMember[]
  invitations CompanyInvitation[]
  orphanedTasks CompanyOrphanedTask[]
  documents   CompanyDocument[]

  @@index([category], name: "idx_companies_category")
  @@index([status], name: "idx_companies_status")
  @@index([verificationStatus], name: "idx_companies_verification_status")
  @@schema("identity")
  @@map("companies")
}

model CompanyDocument {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  uploadedBy     String    @map("uploaded_by") @db.Uuid
  documentType   String    @default("other") @map("document_type") @db.VarChar(100)
  documentName   String    @map("document_name") @db.VarChar(255)
  fileName       String    @map("file_name") @db.VarChar(255)
  storagePath    String    @map("storage_path") @db.Text
  publicUrl      String    @map("public_url") @db.Text
  mimeType       String?   @map("mime_type") @db.VarChar(100)
  fileSizeBytes  Int?      @map("file_size_bytes")
  status         String    @default("pending") @db.VarChar(30)
  reviewNotes    String?   @map("review_notes") @db.Text
  reviewedBy     String?   @map("reviewed_by") @db.Uuid
  reviewedAt     DateTime? @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId], name: "idx_company_documents_company")
  @@index([companyId, status], name: "idx_company_documents_status")
  @@schema("identity")
  @@map("company_documents")
}

model CompanyMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @db.VarChar(50)
  isAdmin     Boolean   @default(false) @map("is_admin")
  status      String    @default("active") @db.VarChar(30)
  permissions Json      @default("[]") @db.JsonB
  invitedBy          String?   @map("invited_by") @db.Uuid
  joinedAt           DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  revokedAt          DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy          String?   @map("revoked_by") @db.Uuid
  commissionSplitPct Decimal?  @map("commission_split_pct") @db.Decimal(5, 2)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId], name: "idx_company_members_company")
  @@index([userId], name: "idx_company_members_user")
  @@index([status], name: "idx_company_members_status")
  @@schema("identity")
  @@map("company_members")
}

model CompanyInvitation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  invitedEmail  String    @map("invited_email") @db.VarChar(255)
  role          String    @db.VarChar(50)
  isAdmin       Boolean   @default(false) @map("is_admin")
  permissions   Json      @default("[]") @db.JsonB
  tokenHash     String    @map("token_hash") @db.VarChar(64)
  status        String    @default("pending") @db.VarChar(30)
  invitedBy     String?   @map("invited_by") @db.Uuid
  acceptedBy    String?   @map("accepted_by") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([companyId, status], name: "idx_company_invitations_company")
  @@schema("identity")
  @@map("company_invitations")
}

model CompanyOrphanedTask {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  originalUserId       String    @map("original_user_id") @db.Uuid
  assigneeId           String?   @map("assignee_id") @db.Uuid
  resourceType         String    @map("resource_type") @db.VarChar(100)
  resourceId           String?   @map("resource_id") @db.Uuid
  description          String?   @db.Text
  requiresNotification Boolean   @default(false) @map("requires_notification")
  notificationNotes    String?   @map("notification_notes") @db.Text
  status               String    @default("unassigned") @db.VarChar(30)
  assignedAt           DateTime? @map("assigned_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy             String?   @map("closed_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status], name: "idx_company_orphaned_tasks_company")
  @@index([originalUserId], name: "idx_company_orphaned_tasks_user")
  @@schema("identity")
  @@map("company_orphaned_tasks")
}

// ============================================
// IDENTITY SCHEMA - Sprint 02 Enhanced Models
// ============================================

model IdentityRoleExclusion {
  roleAId String  @map("role_a_id") @db.Uuid
  roleBId String  @map("role_b_id") @db.Uuid
  reason  String? @db.Text

  @@id([roleAId, roleBId])
  @@schema("identity")
  @@map("role_exclusions")
}

model IdentityProfessionalLicence {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  licenceType        String    @map("licence_type") @db.VarChar(50)
  licenceNumber      String    @map("licence_number") @db.VarChar(100)
  issuingBody        String    @map("issuing_body") @db.VarChar(255)
  issueDate          DateTime? @map("issue_date") @db.Date
  expiryDate         DateTime? @map("expiry_date") @db.Date
  licenceDocumentUrl String?   @map("licence_document_url") @db.Text
  status             String    @default("unverified") @db.VarChar(20)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  autoCheckUrl       String?   @map("auto_check_url") @db.Text
  autoCheckedAt      DateTime? @map("auto_checked_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([userId, licenceType], name: "idx_professional_licences_user")
  @@index([status], name: "idx_professional_licences_status")
  @@index([expiryDate], name: "idx_professional_licences_expiry")
  @@schema("identity")
  @@map("professional_licences")
}

model IdentityUserSession {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @map("user_id") @db.Uuid
  sessionTokenHash  String    @unique @map("session_token_hash") @db.VarChar(255)
  deviceFingerprint String?   @map("device_fingerprint") @db.VarChar(255)
  deviceName        String?   @map("device_name") @db.VarChar(100)
  ipAddress         String?   @map("ip_address") @db.Inet
  countryCode       String?   @map("country_code") @db.Char(2)
  lastActiveAt      DateTime  @default(now()) @map("last_active_at") @db.Timestamptz(6)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId, expiresAt], name: "idx_user_sessions_user_expires")
  @@schema("identity")
  @@map("user_sessions")
}

model IdentityMfaConfig {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String   @unique @map("user_id") @db.Uuid
  totpSecretEncrypted String?  @map("totp_secret_encrypted") @db.Text
  totpEnabled         Boolean  @default(false) @map("totp_enabled")
  smsEnabled          Boolean  @default(false) @map("sms_enabled")
  fido2Enabled        Boolean  @default(false) @map("fido2_enabled")
  fido2Credentials    Json     @default("[]") @map("fido2_credentials") @db.JsonB
  backupCodesHash     Json     @default("[]") @map("backup_codes_hash") @db.JsonB
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("mfa_configs")
}

model IdentityLead {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  agentId            String   @map("agent_id") @db.Uuid
  contactName        String   @map("contact_name") @db.VarChar(255)
  contactEmail       String?  @map("contact_email") @db.VarChar(255)
  contactPhone       String?  @map("contact_phone") @db.VarChar(30)
  leadSource         String?  @map("lead_source") @db.VarChar(50)
  buyerRequirements  Json?    @map("buyer_requirements") @db.JsonB
  status             String   @default("new") @db.VarChar(20)
  notes              String?  @db.Text
  assignedPropertyId String?  @map("assigned_property_id") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  activities IdentityLeadActivity[]

  @@index([agentId, status], name: "idx_leads_agent_status")
  @@schema("identity")
  @@map("leads")
}

model IdentityLeadActivity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leadId       String    @map("lead_id") @db.Uuid
  agentId      String    @map("agent_id") @db.Uuid
  activityType String?   @map("activity_type") @db.VarChar(50)
  notes        String?   @db.Text
  scheduledAt  DateTime? @map("scheduled_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  lead IdentityLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId], name: "idx_lead_activities_lead")
  @@schema("identity")
  @@map("lead_activities")
}

model IdentityNotificationPreference {
  userId          String   @id @map("user_id") @db.Uuid
  emailEnabled    Boolean  @default(true) @map("email_enabled")
  smsEnabled      Boolean  @default(true) @map("sms_enabled")
  pushEnabled     Boolean  @default(true) @map("push_enabled")
  whatsappEnabled Boolean  @default(false) @map("whatsapp_enabled")
  topics          Json     @default("{}") @db.JsonB
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("notification_preferences")
}

// ============================================
// PROPERTY SCHEMA - Listings, Ownership
// ============================================

model Property {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String    @db.VarChar(255)
  description        String?   @db.Text
  propertyType       String    @map("property_type") @db.VarChar(30)
  listingType        String?   @map("listing_type") @db.VarChar(20)
  status             String    @default("draft") @db.VarChar(30)
  price              Decimal   @db.Decimal(18, 2)
  currency           String    @default("USD") @db.Char(3)
  areaSqm            Decimal?  @map("area_sqm") @db.Decimal(10, 2)
  bedrooms           Int?      @db.SmallInt
  bathrooms          Int?      @db.SmallInt
  parkingSpaces      Int?      @map("parking_spaces") @db.SmallInt
  features           Json      @default("[]") @db.JsonB
  agentId            String?   @map("agent_id") @db.Uuid
  ownerId            String?   @map("owner_id") @db.Uuid
  /// Company the agent was acting under when the listing was created (from JWT active_company_id)
  companyId          String?   @map("company_id") @db.Uuid
  verificationStatus String    @default("unverified") @map("verification_status") @db.VarChar(30)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  // Sprint 03 Enhanced — extended attributes
  propertySubtype    String?   @map("property_subtype") @db.VarChar(50)
  erfSizeSqm         Decimal?  @map("erf_size_sqm") @db.Decimal(10, 2)
  floorAreaSqm       Decimal?  @map("floor_area_sqm") @db.Decimal(10, 2)
  garages            Int?      @default(0) @db.SmallInt
  carports           Int?      @default(0) @db.SmallInt
  monthlyLevy        Decimal?  @map("monthly_levy") @db.Decimal(10, 2)
  monthlyRates       Decimal?  @map("monthly_rates") @db.Decimal(10, 2)
  monthlyUtilities   Decimal?  @map("monthly_utilities") @db.Decimal(10, 2)
  titleType          String?   @map("title_type") @db.VarChar(30)
  zoning             String?   @db.VarChar(50)
  bodyCorporateName  String?   @map("body_corporate_name") @db.VarChar(255)
  petPolicy          String?   @map("pet_policy") @db.VarChar(20)
  occupationalDate   DateTime? @map("occupational_date") @db.Date
  sellerApprovedAt   DateTime? @map("seller_approved_at") @db.Timestamptz(6)
  listingReference   String?   @unique @map("listing_reference") @db.VarChar(30)

  @@index([agentId], name: "idx_properties_agent")
  @@index([status], name: "idx_properties_status")
  @@index([propertyType], name: "idx_properties_type")
