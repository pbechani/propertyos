// PRIBEC Database Schema
// PostgreSQL configuration

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["identity", "property", "sales", "financial", "construction", "marketplace", "logistics", "inspection", "analytics", "ai_engine", "audit", "common"]
}

// ============================================
// COMMON SCHEMA - Shared Lookup Tables
// ============================================

model Country {
  code         String  @id @db.VarChar(2)
  name         String  @db.VarChar(100)
  currencyCode String? @map("currency_code") @db.VarChar(3)
  phoneCode    String  @map("phone_code") @db.VarChar(5)
  isActive     Boolean @default(true) @map("is_active")

  @@schema("common")
  @@map("countries")
}

model Currency {
  code          String  @id @db.VarChar(3)
  name          String  @db.VarChar(50)
  symbol        String  @db.VarChar(5)
  decimalPlaces Int     @default(2) @map("decimal_places") @db.SmallInt
  isActive      Boolean @default(true) @map("is_active")

  @@schema("common")
  @@map("currencies")
}

// ============================================
// AUDIT SCHEMA - Cross-cutting Audit Logs
// ============================================

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  schemaName String   @map("schema_name") @db.VarChar(50)
  tableName  String   @map("table_name") @db.VarChar(100)
  recordId   String   @map("record_id") @db.Uuid
  action     String   @db.VarChar(20) // INSERT, UPDATE, DELETE
  oldData    Json?    @map("old_data") @db.JsonB
  newData    Json?    @map("new_data") @db.JsonB
  userId     String?  @map("user_id") @db.Uuid
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent") @db.Text
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([schemaName, tableName, recordId], name: "idx_audit_logs_record")
  @@index([userId], name: "idx_audit_logs_user")
  @@index([createdAt], name: "idx_audit_logs_created")
  @@schema("audit")
  @@map("logs")
}

// ============================================
// IDENTITY SCHEMA - Users, Roles, KYC
// ============================================

model IdentityUser {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique @db.VarChar(255)
  phone           String?   @db.VarChar(20)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  avatarUrl       String?   @map("avatar_url") @db.Text
  status          String    @default("active") @db.VarChar(20)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  phoneVerifiedAt DateTime? @map("phone_verified_at") @db.Timestamptz(6)
  lastLoginAt     DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("users")
}

model IdentityRole {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique @db.VarChar(50)
  displayName String   @map("display_name") @db.VarChar(100)
  description String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@schema("identity")
  @@map("roles")
}

model IdentityUserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)

  @@id([userId, roleId])
  @@schema("identity")
  @@map("user_roles")
}

model IdentityPermission {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource String @db.VarChar(100)
  action   String @db.VarChar(50)

  @@unique([resource, action])
  @@schema("identity")
  @@map("permissions")
}

model IdentityRolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  @@id([roleId, permissionId])
  @@schema("identity")
  @@map("role_permissions")
}

model IdentityKycVerification {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                  String    @map("user_id") @db.Uuid
  status                  String    @default("pending") @db.VarChar(20)
  idDocumentUrl           String?   @map("id_document_url") @db.Text
  idDocumentType          String?   @map("id_document_type") @db.VarChar(50)
  addressProofUrl         String?   @map("address_proof_url") @db.Text
  businessRegistrationUrl String?   @map("business_registration_url") @db.Text
  selfieUrl               String?   @map("selfie_url") @db.Text
  reviewerId              String?   @map("reviewer_id") @db.Uuid
  reviewerNotes           String?   @map("reviewer_notes") @db.Text
  reviewedAt              DateTime? @map("reviewed_at") @db.Timestamptz(6)
  submittedAt             DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], name: "idx_kyc_user")
  @@index([status, submittedAt], name: "idx_kyc_status_submitted")
  @@schema("identity")
  @@map("kyc_verifications")
}

model IdentityAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String   @map("event_id") @db.VarChar(100)
  actorId        String?  @map("actor_id") @db.Uuid
  actorRole      String?  @map("actor_role") @db.VarChar(50)
  companyId      String?  @map("company_id") @db.Uuid
  action         String   @db.VarChar(100)
  resourceType   String?  @map("resource_type") @db.VarChar(100)
  resourceId     String?  @map("resource_id") @db.Uuid
  payload        Json?    @db.JsonB
  ipAddress      String?  @map("ip_address") @db.Inet
  userAgent      String?  @map("user_agent") @db.Text
  deviceMetadata Json?    @map("device_metadata") @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt], name: "idx_identity_audit_actor_created")
  @@index([resourceType, resourceId], name: "idx_identity_audit_resource")
  @@schema("identity")
  @@map("audit_logs")
}

model IdentityRefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId], name: "idx_refresh_tokens_user")
  @@schema("identity")
  @@map("refresh_tokens")
}

// ============================================
// IDENTITY SCHEMA - Companies (Sprint 01-b)
// ============================================

model Company {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String    @db.VarChar(255)
  slug               String    @unique @db.VarChar(100)
  category           String    @db.VarChar(50)
  registrationNumber String?   @map("registration_number") @db.VarChar(100)
  taxNumber          String?   @map("tax_number") @db.VarChar(100)
  website            String?   @db.VarChar(255)
  phone              String?   @db.VarChar(20)
  email              String    @db.VarChar(255)
  address            Json      @default("{}") @db.JsonB
  logoUrl            String?   @map("logo_url") @db.Text
  description        String?   @db.Text
  status             String    @default("pending_verification") @db.VarChar(30)
  verificationStatus String    @default("unverified") @map("verification_status") @db.VarChar(30)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  rejectionReason    String?   @map("rejection_reason") @db.Text
  isSystem           Boolean   @default(false) @map("is_system")
  createdBy          String?   @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  members     CompanyMember[]
  invitations CompanyInvitation[]
  orphanedTasks CompanyOrphanedTask[]

  @@index([category], name: "idx_companies_category")
  @@index([status], name: "idx_companies_status")
  @@index([verificationStatus], name: "idx_companies_verification_status")
  @@schema("identity")
  @@map("companies")
}

model CompanyMember {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        String    @db.VarChar(50)
  isAdmin     Boolean   @default(false) @map("is_admin")
  status      String    @default("active") @db.VarChar(30)
  permissions Json      @default("[]") @db.JsonB
  invitedBy   String?   @map("invited_by") @db.Uuid
  joinedAt    DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedBy   String?   @map("revoked_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, userId])
  @@index([companyId], name: "idx_company_members_company")
  @@index([userId], name: "idx_company_members_user")
  @@index([status], name: "idx_company_members_status")
  @@schema("identity")
  @@map("company_members")
}

model CompanyInvitation {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String    @map("company_id") @db.Uuid
  invitedEmail  String    @map("invited_email") @db.VarChar(255)
  role          String    @db.VarChar(50)
  isAdmin       Boolean   @default(false) @map("is_admin")
  permissions   Json      @default("[]") @db.JsonB
  tokenHash     String    @map("token_hash") @db.VarChar(64)
  status        String    @default("pending") @db.VarChar(30)
  invitedBy     String?   @map("invited_by") @db.Uuid
  acceptedBy    String?   @map("accepted_by") @db.Uuid
  expiresAt     DateTime  @map("expires_at") @db.Timestamptz(6)
  acceptedAt    DateTime? @map("accepted_at") @db.Timestamptz(6)
  revokedAt     DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([tokenHash])
  @@index([companyId, status], name: "idx_company_invitations_company")
  @@schema("identity")
  @@map("company_invitations")
}

model CompanyOrphanedTask {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String    @map("company_id") @db.Uuid
  originalUserId       String    @map("original_user_id") @db.Uuid
  assigneeId           String?   @map("assignee_id") @db.Uuid
  resourceType         String    @map("resource_type") @db.VarChar(100)
  resourceId           String?   @map("resource_id") @db.Uuid
  description          String?   @db.Text
  requiresNotification Boolean   @default(false) @map("requires_notification")
  notificationNotes    String?   @map("notification_notes") @db.Text
  status               String    @default("unassigned") @db.VarChar(30)
  assignedAt           DateTime? @map("assigned_at") @db.Timestamptz(6)
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  closedBy             String?   @map("closed_by") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status], name: "idx_company_orphaned_tasks_company")
  @@index([originalUserId], name: "idx_company_orphaned_tasks_user")
  @@schema("identity")
  @@map("company_orphaned_tasks")
}

// ============================================
// PROPERTY SCHEMA - Listings, Ownership
// ============================================

model Property {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title              String    @db.VarChar(255)
  description        String?   @db.Text
  propertyType       String    @map("property_type") @db.VarChar(30)
  listingType        String?   @map("listing_type") @db.VarChar(20)
  status             String    @default("draft") @db.VarChar(30)
  price              Decimal   @db.Decimal(18, 2)
  currency           String    @default("USD") @db.Char(3)
  areaSqm            Decimal?  @map("area_sqm") @db.Decimal(10, 2)
  bedrooms           Int?      @db.SmallInt
  bathrooms          Int?      @db.SmallInt
  parkingSpaces      Int?      @map("parking_spaces") @db.SmallInt
  features           Json      @default("[]") @db.JsonB
  agentId            String?   @map("agent_id") @db.Uuid
  ownerId            String?   @map("owner_id") @db.Uuid
  /// Company the agent was acting under when the listing was created (from JWT active_company_id)
  companyId          String?   @map("company_id") @db.Uuid
  verificationStatus String    @default("unverified") @map("verification_status") @db.VarChar(30)
  verifiedAt         DateTime? @map("verified_at") @db.Timestamptz(6)
  verifiedBy         String?   @map("verified_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([agentId], name: "idx_properties_agent")
  @@index([status], name: "idx_properties_status")
  @@index([propertyType], name: "idx_properties_type")
  @@index([listingType], name: "idx_properties_listing_type")
  @@index([verificationStatus], name: "idx_properties_verification")
  @@index([price], name: "idx_properties_price")
  @@index([companyId], name: "idx_properties_company")
  @@schema("property")
  @@map("properties")
}

model PropertyLocation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  addressLine1 String?  @map("address_line1") @db.VarChar(255)
  addressLine2 String?  @map("address_line2") @db.VarChar(255)
  city         String?  @db.VarChar(100)
  region       String?  @db.VarChar(100)
  country      String   @db.Char(2)
  postalCode   String?  @map("postal_code") @db.VarChar(20)
  latitude     Decimal? @db.Decimal(9, 6)
  longitude    Decimal? @db.Decimal(9, 6)

  @@index([propertyId], name: "idx_property_locations_property")
  @@schema("property")
  @@map("property_locations")
}

model PropertyMedia {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId   String   @map("property_id") @db.Uuid
  mediaType    String   @map("media_type") @db.VarChar(10)
  url          String   @db.Text
  thumbnailUrl String?  @map("thumbnail_url") @db.Text
  displayOrder Int      @default(0) @map("display_order") @db.SmallInt
  isPrimary    Boolean  @default(false) @map("is_primary")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([propertyId], name: "idx_property_media_property")
  @@schema("property")
  @@map("property_media")
}

model OwnershipHistory {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId       String   @map("property_id") @db.Uuid
  ownerId          String?  @map("owner_id") @db.Uuid
  ownerName        String?  @map("owner_name") @db.VarChar(255)
  transferDate     DateTime? @map("transfer_date") @db.Date
  transferPrice    Decimal?  @map("transfer_price") @db.Decimal(18, 2)
  transferCurrency String?   @map("transfer_currency") @db.Char(3)
  titleDeedUrl     String?   @map("title_deed_url") @db.Text
  notes            String?   @db.Text
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([propertyId], name: "idx_ownership_history_property")
  @@schema("property")
  @@map("ownership_history")
}

model PropertyVerification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId        String    @map("property_id") @db.Uuid
  titleDeedUrl      String?   @map("title_deed_url") @db.Text
  deedNumber        String?   @map("deed_number") @db.VarChar(100)
  registryReference String?   @map("registry_reference") @db.VarChar(100)
  status            String    @default("pending") @db.VarChar(30)
  reviewerId        String?   @map("reviewer_id") @db.Uuid
  reviewerNotes     String?   @map("reviewer_notes") @db.Text
  reviewedAt        DateTime? @map("reviewed_at") @db.Timestamptz(6)
  submittedAt       DateTime  @default(now()) @map("submitted_at") @db.Timestamptz(6)

  @@index([propertyId], name: "idx_verifications_property")
  @@index([status], name: "idx_verifications_status")
  @@schema("property")
  @@map("verifications")
}

model PropertyInquiry {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId    String    @map("property_id") @db.Uuid
  buyerId       String    @map("buyer_id") @db.Uuid
  /// Company the buyer was acting under at the time of inquiry (from JWT active_company_id)
  companyId     String?   @map("company_id") @db.Uuid
  inquiryType   String    @map("inquiry_type") @db.VarChar(20)
  message       String?   @db.Text
  preferredDate DateTime? @map("preferred_date") @db.Timestamptz(6)
  status        String    @default("pending") @db.VarChar(20)
  response      String?   @db.Text
  respondedAt   DateTime? @map("responded_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([propertyId], name: "idx_inquiries_property")
  @@index([buyerId], name: "idx_inquiries_buyer")
  @@index([companyId], name: "idx_inquiries_company")
  @@schema("property")
  @@map("inquiries")
}

model SavedProperty {
  userId     String   @map("user_id") @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([userId, propertyId])
  @@index([userId], name: "idx_saved_properties_user")
  @@schema("property")
  @@map("saved_properties")
}

model FraudReport {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId      String    @map("property_id") @db.Uuid
  reporterId      String    @map("reporter_id") @db.Uuid
  /// Company the reporter was acting under when submitting the report (from JWT active_company_id)
  companyId       String?   @map("company_id") @db.Uuid
  reportType      String    @map("report_type") @db.VarChar(50)
  description     String    @db.Text
  evidenceUrls    Json      @default("[]") @map("evidence_urls") @db.JsonB
  status          String    @default("submitted") @db.VarChar(30)
  resolverId      String?   @map("resolver_id") @db.Uuid
  resolutionNotes String?   @map("resolution_notes") @db.Text
  resolvedAt      DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([propertyId], name: "idx_fraud_reports_property")
  @@index([status], name: "idx_fraud_reports_status")
  @@index([companyId], name: "idx_fraud_reports_company")
  @@schema("property")
  @@map("fraud_reports")
}

model PropertyAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @map("event_id") @db.VarChar(100)
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(50)
  /// Company context under which this action was performed (from JWT active_company_id)
  companyId    String?  @map("company_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  payload      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([actorId, createdAt], name: "idx_property_audit_actor")
  @@index([resourceType, resourceId], name: "idx_property_audit_resource")
  @@index([companyId], name: "idx_property_audit_company")
  @@schema("property")
  @@map("audit_logs")
}

// ============================================
// SALES SCHEMA - Purchase Pipeline (Sprint 04)
// ============================================

model SaleStageConfig {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  country              String   @db.Char(2)
  stageNumber          Int      @map("stage_number") @db.SmallInt
  stageName            String   @map("stage_name") @db.VarChar(100)
  description          String?  @db.Text
  responsibleRole      String?  @map("responsible_role") @db.VarChar(50)
  isBlocker            Boolean  @default(false) @map("is_blocker")
  governmentDept       String?  @map("government_dept") @db.VarChar(100)
  typicalDurationDays  Int?     @map("typical_duration_days") @db.SmallInt
  requiredDocuments    Json     @default("[]") @map("required_documents") @db.JsonB
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([country, stageNumber], name: "uq_stage_config_country_stage")
  @@index([country], name: "idx_stage_configs_country")
  @@schema("sales")
  @@map("stage_configs")
}

model PropertySale {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  propertyId           String    @map("property_id") @db.Uuid
  saleReference        String    @unique @map("sale_reference") @db.VarChar(50)
  sellerId             String    @map("seller_id") @db.Uuid
  buyerId              String?   @map("buyer_id") @db.Uuid
  agentId              String?   @map("agent_id") @db.Uuid
  buyerConveyancerId   String?   @map("buyer_conveyancer_id") @db.Uuid
  sellerConveyancerId  String?   @map("seller_conveyancer_id") @db.Uuid
  agreedPrice          Decimal   @map("agreed_price") @db.Decimal(18, 2)
  currency             String    @default("ZAR") @db.Char(3)
  depositAmount        Decimal?  @map("deposit_amount") @db.Decimal(18, 2)
  status               String    @default("active") @db.VarChar(30)
  currentStage         Int       @default(1) @map("current_stage") @db.SmallInt
  country              String    @default("ZA") @db.Char(2)
  companyId            String?   @map("company_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  stageProgress        SaleStageProgress[]
  documents            SaleStageDocument[]
  governmentInteractions GovernmentInteraction[]
  issues               SaleIssue[]
  messages             SaleMessage[]

  @@index([propertyId], name: "idx_property_sales_property")
  @@index([sellerId],   name: "idx_property_sales_seller")
  @@index([buyerId],    name: "idx_property_sales_buyer")
  @@index([agentId],    name: "idx_property_sales_agent")
  @@index([status],     name: "idx_property_sales_status")
  @@index([companyId],  name: "idx_property_sales_company")
  @@schema("sales")
  @@map("property_sales")
}

model SaleStageProgress {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId       String    @map("sale_id") @db.Uuid
  stageNumber  Int       @map("stage_number") @db.SmallInt
  status       String    @default("not_started") @db.VarChar(20)
  startedAt    DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt  DateTime? @map("completed_at") @db.Timestamptz(6)
  completedBy  String?   @map("completed_by") @db.Uuid
  daysInStage  Int?      @map("days_in_stage")
  notes        String?   @db.Text

  sale         PropertySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@unique([saleId, stageNumber], name: "uq_stage_progress_sale_stage")
  @@index([saleId],  name: "idx_stage_progress_sale")
  @@index([status],  name: "idx_stage_progress_status")
  @@schema("sales")
  @@map("sale_stage_progress")
}

model SaleStageDocument {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId        String   @map("sale_id") @db.Uuid
  stageNumber   Int      @map("stage_number") @db.SmallInt
  documentName  String   @map("document_name") @db.VarChar(255)
  documentType  String?  @map("document_type") @db.VarChar(100)
  url           String?  @db.Text
  version       Int      @default(1) @db.SmallInt
  uploadedBy    String?  @map("uploaded_by") @db.Uuid
  status        String   @default("pending") @db.VarChar(20)
  isRequired    Boolean  @default(false) @map("is_required")
  uploadedAt    DateTime @default(now()) @map("uploaded_at") @db.Timestamptz(6)

  sale          PropertySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId],                   name: "idx_stage_documents_sale")
  @@index([saleId, stageNumber],      name: "idx_stage_documents_stage")
  @@schema("sales")
  @@map("stage_documents")
}

model GovernmentInteraction {
  id                      String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId                  String    @map("sale_id") @db.Uuid
  stageNumber             Int       @map("stage_number") @db.SmallInt
  departmentName          String    @map("department_name") @db.VarChar(100)
  applicationReference    String?   @map("application_reference") @db.VarChar(100)
  submissionDate          DateTime? @map("submission_date") @db.Date
  expectedCompletionDate  DateTime? @map("expected_completion_date") @db.Date
  actualCompletionDate    DateTime? @map("actual_completion_date") @db.Date
  status                  String    @default("pending") @db.VarChar(30)
  notes                   String?   @db.Text
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  sale                    PropertySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId], name: "idx_gov_interactions_sale")
  @@schema("sales")
  @@map("government_interactions")
}

model SaleIssue {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId       String    @map("sale_id") @db.Uuid
  stageNumber  Int?      @map("stage_number") @db.SmallInt
  reportedBy   String?   @map("reported_by") @db.Uuid
  issueType    String?   @map("issue_type") @db.VarChar(50)
  description  String    @db.Text
  status       String    @default("open") @db.VarChar(20)
  resolvedAt   DateTime? @map("resolved_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  sale         PropertySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId],  name: "idx_sale_issues_sale")
  @@index([status],  name: "idx_sale_issues_status")
  @@schema("sales")
  @@map("sale_issues")
}

model SaleMessage {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  saleId          String   @map("sale_id") @db.Uuid
  senderId        String   @map("sender_id") @db.Uuid
  message         String   @db.Text
  attachments     Json     @default("[]") @db.JsonB
  visibleToRoles  Json     @default("[\"buyer\",\"seller\",\"agent\",\"conveyancer\"]") @map("visible_to_roles") @db.JsonB
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale            PropertySale @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId],    name: "idx_sale_messages_sale")
  @@index([senderId],  name: "idx_sale_messages_sender")
  @@schema("sales")
  @@map("sale_messages")
}

model SalesAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId      String   @unique @default(dbgenerated("gen_random_uuid()")) @map("event_id") @db.Uuid
  actorId      String?  @map("actor_id") @db.Uuid
  actorRole    String?  @map("actor_role") @db.VarChar(50)
  companyId    String?  @map("company_id") @db.Uuid
  action       String   @db.VarChar(100)
  resourceType String?  @map("resource_type") @db.VarChar(100)
  resourceId   String?  @map("resource_id") @db.Uuid
  payload      Json?    @db.JsonB
  ipAddress    String?  @map("ip_address") @db.Inet
  userAgent    String?  @map("user_agent") @db.Text
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([resourceType, resourceId], name: "idx_sales_audit_resource")
  @@index([actorId],                  name: "idx_sales_audit_actor")
  @@index([action],                   name: "idx_sales_audit_action")
  @@schema("sales")
  @@map("audit_logs")
}

