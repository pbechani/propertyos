# API Environment Variables
# Copy to .env for local development

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgres://pribec:pribec_dev_password@localhost:5432/pribec_dev

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://pribec:pribec_dev_password@localhost:5672

# Security
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Local file storage (avatars/KYC docs)
# Use an absolute path so files persist across API restarts.
LOCAL_STORAGE_DIR=/absolute/path/to/pribec-storage
# Public base URL used when generating stored file links
PUBLIC_STORAGE_BASE_URL=http://localhost:3001/storage

SENTRY_DSN=https://09659e59c8f8ebdcee3d738d1045d87e@o4510920016855040.ingest.de.sentry.io/4510920029962320

# ── LLM Gateway (PDR-007) ─────────────────────────────────────────────────────
# All optional. If LLM_API_KEY is not set the assistant falls back to the
# keyword/semantic router and shows a static help message for unknown queries.
#
# Supported providers: openai | anthropic | gemini
# Recommended models:
#   openai    → gpt-4o-mini  (fast, cheap, good JSON mode support)
#   anthropic → claude-3-haiku-20240307  (fast, affordable)
#   gemini    → gemini-1.5-flash  (free tier available)
#
# ── GitHub Models (free with a GitHub account) ────────────────────────────────
# GitHub Models is OpenAI-compatible. Obtain a GitHub PAT (classic or
# fine-grained with "Models: Read and Write" access), or use the built-in
# GITHUB_TOKEN in GitHub Actions. Set LLM_BASE_URL to override the endpoint:
#
#   LLM_PROVIDER=openai
#   LLM_API_KEY=github_pat_xxxxxxxxxxxxxxxxxxxx
#   LLM_MODEL=gpt-4o-mini
#   LLM_BASE_URL=https://models.inference.ai.azure.com
#
LLM_PROVIDER=openai
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
#
# Optional second provider used as fallback when primary fails:
# LLM_FALLBACK_PROVIDER=anthropic
# LLM_FALLBACK_API_KEY=sk-ant-...
# LLM_FALLBACK_MODEL=claude-3-haiku-20240307
# LLM_FALLBACK_BASE_URL=

# Email provider: smtp | sendgrid | none (default)
# For local dev, use smtp pointing at Mailpit (docker-compose service on port 1025)
# Web UI at http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@pribec.local
# SMTP_USER=          # leave blank — Mailpit does not require auth
# SMTP_PASS=          # leave blank — Mailpit does not require auth

# Production SendGrid (only used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
