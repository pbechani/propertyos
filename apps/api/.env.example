# API Environment Variables
# Copy to .env for local development

NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgres://pribec:pribec_dev_password@localhost:5432/pribec_dev

# Redis
REDIS_URL=redis://localhost:6379

# RabbitMQ
RABBITMQ_URL=amqp://pribec:pribec_dev_password@localhost:5672

# Security
JWT_SECRET=dev-jwt-secret-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# Local file storage (avatars/KYC docs)
# Use an absolute path so files persist across API restarts.
LOCAL_STORAGE_DIR=/absolute/path/to/pribec-storage
# Public base URL used when generating stored file links
PUBLIC_STORAGE_BASE_URL=http://localhost:3001/storage

SENTRY_DSN=https://09659e59c8f8ebdcee3d738d1045d87e@o4510920016855040.ingest.de.sentry.io/4510920029962320

# Email provider: smtp | sendgrid | none (default)
# For local dev, use smtp pointing at Mailpit (docker-compose service on port 1025)
# Web UI at http://localhost:8025
EMAIL_PROVIDER=smtp
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@pribec.local
# SMTP_USER=          # leave blank — Mailpit does not require auth
# SMTP_PASS=          # leave blank — Mailpit does not require auth

# Production SendGrid (only used when EMAIL_PROVIDER=sendgrid)
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
