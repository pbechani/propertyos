# Web Environment Variables
# Copy to .env.local for local development

# Preferred API base (used by web API client)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Backward-compatible alias (optional)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Optional: explicit storage public base URL used for avatar/document images
# If omitted, this is derived from NEXT_PUBLIC_API_BASE_URL as <api-origin>/storage
# NEXT_PUBLIC_STORAGE_BASE_URL=http://localhost:3001/storage
