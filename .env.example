# PRIBEC Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ===========================================
# Application
# ===========================================
NODE_ENV=development
PORT=3001
CORS_ORIGINS=http://localhost:3000

# ===========================================
# Database (PostgreSQL)
# ===========================================
DATABASE_URL=postgres://pribec:pribec_dev_password@localhost:5432/pribec_dev
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20

# ===========================================
# Redis Cache
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Message Broker (RabbitMQ)
# ===========================================
RABBITMQ_URL=amqp://pribec:pribec_dev_password@localhost:5672

# ===========================================
# Object Storage (MinIO/S3)
# ===========================================
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=pribec-docs
S3_REGION=us-east-1
S3_ACCESS_KEY=pribec_access_key
S3_SECRET_KEY=pribec_secret_key

# ===========================================
# Authentication & Security
# ===========================================
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# AES-256 encryption key for sensitive data
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=your-encryption-key-change-in-production

# ===========================================
# Secrets Management (Vault)
# ===========================================
VAULT_ENABLED=false
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=pribec-dev-token

# ===========================================
# Observability
# ===========================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Elasticsearch for logging
ELASTICSEARCH_URL=http://localhost:9200

# ===========================================
# External Services (Add as needed)
# ===========================================
# AI/LLM Providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMS/Email
SENDGRID_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# KYC Provider
KYC_PROVIDER_API_KEY=
KYC_PROVIDER_SECRET=
